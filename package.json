{
  "name": "pi-desktop",
  "productName": "Pi Desktop",
  "version": "1.6.0",
  "description": "Desktop companion for the Pi coding agent: chat history, provider/model switching, and self-updating pi independent of the app.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": {
    "name": "Lorenzo",
    "email": "lorenzo@pi.dev"
  },
  "homepage": "https://pi.dev",
  "scripts": {
    "start": "node scripts/prepare-build-assets.js && electron .",
    "check": "node scripts/check.js",
    "verify": "node scripts/verify.js",
    "verify:quick": "node scripts/verify.js --quick",
    "prepare": "node scripts/install-hooks.js && node scripts/prepare-build-assets.js",
    "test": "node --test test/*.test.mjs",
    "test:legacy": "node test/rpc.test.mjs",
    "lint": "eslint src --ext .js,.mjs",
    "lint:fix": "eslint src --ext .js,.mjs --fix",
    "dist": "electron-builder",
    "release:check": "node scripts/check-release-version.js",
    "release:assets": "node scripts/release-assets.js"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "semantic-release": "^24.2.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide": "^1.34.0"
  }
}
