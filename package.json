{
  "name": "pi-desktop",
  "productName": "Pi Desktop",
  "version": "0.1.0",
  "description": "Desktop companion for the Pi coding agent: chat history, provider/model switching, and self-updating pi independent of the app.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": {
    "name": "Lorenzo",
    "email": "lorenzo@pi.dev"
  },
  "homepage": "https://pi.dev",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node test/rpc.test.mjs",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "dev.pi.desktop",
    "productName": "Pi Desktop",
    "files": [
      "src/**/*",
      "package.json",
      "!test/**"
    ],
    "linux": {
      "maintainer": "Lorenzo <lorenzo@pi.dev>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "lucide": "^1.34.0"
  }
}
